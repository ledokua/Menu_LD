// Fallen Eden main menu, converted from the FancyMenu layout "fallenedenv5_light" (2026-10-04).
// Install as config/menu_ld/menu.json5, with the art in config/menu_ld/fallen_eden/:
//   background_night.gif foon.png minecraft2.png minecraft_title.png black_button.png button_light.png
//   button_light_1.png button_green.png button_exit.png gift1.png gift_012.png coind.png coin_056.png
//   gem_01j.png gem_02j.png crystal_01j.png crystal_02j.png
//   menu_music.ogg (418.wav), rain.ogg (heavy rain wav), thunder.ogg (thunder-single-long-strike.wav),
//   converted with: ffmpeg -i in.wav -c:a libvorbis -q:a 4 out.ogg
// Saved changes apply the next time the title screen opens.
{
  "background": {
    "image": "fallen_eden/background_night.gif",
    "fit": "stretch",
    "smooth": true
  },

  "audio": [
    { "sound": "fallen_eden/menu_music.ogg", "source": "music", "loop": true, "volume": 0.4 },
    { "sound": "fallen_eden/rain.ogg", "source": "ambient", "loop": true, "volume": 0.2 }
  ],

  "title_screen": {
    "logo": false,
    "splash": false,
    "realms_notifications": false,

    // Every listed button gets this look unless it sets its own.
    "button_style": {
      "texture": "fallen_eden/black_button.png",
      "hover_texture": "fallen_eden/button_light_1.png",
      "label_color": "#D3C9FF"
    },

    "widgets": {
      "multiplayer": { "hidden": true },
      "realms": { "hidden": true },
      "singleplayer": { "anchor": "center", "x": -65, "y": -1, "width": 130, "height": 21, "fade_in": 1.6 },
      "mods": { "anchor": "center", "x": -65, "y": 27, "width": 130, "height": 21, "fade_in": 1.8 },
      "options": { "anchor": "center", "x": -65, "y": 56, "width": 130, "height": 21, "fade_in": 2.0 },
      "quit": {
        "anchor": "center", "x": -65, "y": 84, "width": 130, "height": 21, "fade_in": 2.2,
        "hover_texture": "fallen_eden/button_exit.png"
      },
      "language": { "anchor": "center", "x": -94, "y": 85, "width": 20, "height": 20, "fade_in": 2.2 },
      // Vanilla accessibility stays reachable from Options; its slot goes to Create's goggles button.
      "accessibility": { "hidden": true },
      "com.simibubi.create.infrastructure.gui.OpenCreateMenuButton": {
        "anchor": "center", "x": 74, "y": 85, "width": 20, "height": 20, "fade_in": 2.2
      }
    },

    "elements": [
      // Dark column behind the logo and buttons. Logo and buttons are one centered block (fits 240 GUI px tall).
      { "type": "image", "image": "fallen_eden/foon.png",
        "anchor": "top", "x": -107, "y": 10, "width": 214, "height": 348, "opacity": 0.3 },
      { "type": "image", "image": "fallen_eden/minecraft2.png",
        "anchor": "center", "x": -50, "y": -94, "width": 100, "height": 49, "fade_in": 1.2 },
      { "type": "image", "image": "fallen_eden/minecraft_title.png",
        "anchor": "center", "x": -90, "y": -113, "width": 179, "height": 42, "fade_in": 1.0 },

      { "type": "button", "action": "join_server", "address": "play.minestar.com.ua:38050",
        "label": { "en_us": "Start the adventure", "uk_ua": "Розпочати пригоду" },
        "anchor": "center", "x": -100, "y": -35, "width": 200, "height": 22, "fade_in": 1.4,
        "texture": "fallen_eden/button_light.png", "hover_texture": "fallen_eden/button_green.png" },

      { "type": "button", "action": "link", "url": "https://minestar.com.ua/prime",
        "tooltip": { "en_us": "Prime", "uk_ua": "Прайм" },
        "anchor": "center", "x": -94, "y": 57, "width": 20, "height": 20, "fade_in": 2.0,
        "texture": "fallen_eden/gift1.png", "hover_texture": "fallen_eden/gift_012.png" },
      { "type": "button", "action": "link", "url": "https://minestar.com.ua/shop",
        "tooltip": { "en_us": "Shop", "uk_ua": "Магазин" },
        "anchor": "center", "x": 74, "y": 57, "width": 20, "height": 20, "fade_in": 2.0,
        "texture": "fallen_eden/coind.png", "hover_texture": "fallen_eden/coin_056.png" },
      { "type": "button", "action": "link", "url": "https://allmc.in.ua/play-minestar-com-ua?nickname={player}",
        "tooltip": { "en_us": "Vote for the server", "uk_ua": "Проголосувати за сервер" },
        "anchor": "center", "x": -94, "y": 28, "width": 20, "height": 20, "fade_in": 2.0,
        "texture": "fallen_eden/gem_01j.png", "hover_texture": "fallen_eden/gem_02j.png" },
      { "type": "button", "action": "link", "url": "https://minestar.com.ua/chests",
        "tooltip": { "en_us": "Chests", "uk_ua": "Скрині" },
        "anchor": "center", "x": 74, "y": 28, "width": 20, "height": 20, "fade_in": 2.0,
        "texture": "fallen_eden/crystal_01j.png", "hover_texture": "fallen_eden/crystal_02j.png" }
    ],

    // Drawn over the background and images, under the buttons.
    "effects": [
      { "type": "rain", "intensity": 1.0, "color": "#CFE7FF",
        "thunder": true, "thunder_brightness": 0.2, "thunder_sound": "fallen_eden/thunder.ogg", "thunder_volume": 0.3 },
      { "type": "fireflies", "intensity": 1.0, "color": "#FFE08A", "follow_mouse": true }
    ]
  },

  "loading_screen": {
    "color": "#070B1E",
    "background": { "image": "fallen_eden/background_night.gif", "fit": "cover", "smooth": true },
    "mojang_logo": false,
    "elements": [
      { "type": "image", "image": "fallen_eden/minecraft2.png",
        "anchor": "center", "x": -100, "y": -62, "width": 200, "height": 98 },
      { "type": "image", "image": "fallen_eden/minecraft_title.png",
        "anchor": "center", "x": -179, "y": -100, "width": 358, "height": 84 }
    ],
    "progress_bar": { "color": "#D3C9FF", "track_color": "#0B0F2AA0", "border_color": "#D3C9FF" }
  }
}
